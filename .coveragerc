[run]
branch = true
# Qt 控件胶水不追求覆盖率（CI 无显示环境）；
# 页面内的纯逻辑由 tests/apps/locllm/test_locllmw_qt_logic.py 覆盖。
omit =
    tests/*
    src/fcmd/gui/qt/*
    src/fcmd/apps/locllm/_locllmw_qt_*.py
    src/fcmd/*/*/_*w_qt.py
    src/fcmd/*/*/_*_qt.py
    src/fcmd/apps/cmder/_cmder_qt*.py
source = fcmd

[report]
fail_under = 95
exclude_lines =
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    pragma: no cover
    raise NotImplementedError
show_missing = true
