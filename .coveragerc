[run]
branch = true
# Qt 控件胶水不追求覆盖率（CI 无显示环境）；
# 页面内的纯逻辑由 tests/apps/llm/test_llmw_qt_logic.py 覆盖。
omit =
    tests/*
    src/fcmd/gui/app.py
    src/fcmd/gui/compat.py
    src/fcmd/gui/icons.py
    src/fcmd/gui/ime.py
    src/fcmd/gui/layout.py
    src/fcmd/gui/logdialog.py
    src/fcmd/gui/page.py
    src/fcmd/gui/shell.py
    src/fcmd/gui/sidebar.py
    src/fcmd/gui/statusbar.py
    src/fcmd/gui/style.py
    src/fcmd/gui/theme_menu.py
    src/fcmd/gui/toolwindow.py
    src/fcmd/gui/window.py
    src/fcmd/gui/workers.py
    src/fcmd/gui/widgets/*
    src/fcmd/apps/llm/_llmw_qt_*.py
    src/fcmd/*/*/_*w_qt.py
    src/fcmd/*/*/_*_qt.py
    src/fcmd/apps/cmder/_cmder_qt*.py
source = fcmd

[report]
fail_under = 95
exclude_lines =
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    pragma: no cover
    raise NotImplementedError
show_missing = true
